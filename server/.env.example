# CampusConnect Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas URI (replace with your MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=campusconnect_super_secure_academic_dev_jwt_key_dbs_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

