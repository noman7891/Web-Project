# CampusConnect Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas URI; replace placeholders with deployment values
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/campusconnect?retryWrites=true&w=majority
MONGODB_DB_NAME=campusconnect

# JWT Authentication
JWT_SECRET=<generate-a-unique-secret-of-at-least-32-characters>
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

